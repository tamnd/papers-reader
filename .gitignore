# Build output.
/bin/
/dist/
# The binary when it is built in place. Anchored, or it would also swallow
# cmd/papers.
/papers

# The corpus download directories, if somebody runs the tool from in here.
# The corpus working directory is also called work, but that name is a Go
# package here, so it is not in this list. Nothing will write one: a corpus
# root has to have manifests/papers.yaml in it, and this is not a corpus.
/pdf/
/images/

# A build of the site. Everything in it is derived from a corpus and is
# built again in the job that deploys it, so a copy in here would only ever
# be a stale one somebody read by mistake.
/site/

# Web app.
/web/node_modules/
/web/dist/
/web/.astro/

# The emit the app is built from. papers emit writes it into web/public and
# the deploy job writes it again from the corpus of the day, so a copy in
# here would be a second corpus that nobody updates. The directory itself
# stays, because Astro wants it and because the app's own static files, if
# it ever has any, belong in it.
/web/public/index.json
/web/public/graph.json
/web/public/search-*.json
/web/public/p/
/web/public/figures/

# Coverage.
*.out
*.test

.DS_Store
